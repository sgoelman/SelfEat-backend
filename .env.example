# Local dev (no local Postgres needed): sqlite+aiosqlite:///./dev.db
# Production (Cloud SQL, self-eat-db in us-central1): value is in Secret Manager as `selfeat-database-url`
DATABASE_URL=postgresql+asyncpg://selfeat:selfeat@localhost:5432/selfeat
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000
